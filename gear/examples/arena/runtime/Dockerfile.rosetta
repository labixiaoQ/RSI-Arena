# Optional Apple Silicon development layer: older bwrap avoids open_tree,
# which Rosetta does not implement. The complete player isolation is retained.
ARG BASE=gear-arena-monecraft:base
FROM ${BASE}
USER 0:0
ADD https://archive.ubuntu.com/ubuntu/pool/main/b/bubblewrap/bubblewrap_0.9.0-1ubuntu0.3_amd64.deb /tmp/bwrap.deb
RUN echo '2461f1beee9cb04c8942739fe1a2b37e7b7c2a3d518f0779dc75f9245baa3094  /tmp/bwrap.deb' | sha256sum -c - \
    && dpkg-deb -x /tmp/bwrap.deb /opt/bwrap-compat \
    && cp /opt/bwrap-compat/usr/bin/bwrap /usr/local/bin/bwrap \
    && rm /tmp/bwrap.deb
USER 1000:1000
